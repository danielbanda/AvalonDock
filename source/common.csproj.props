<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<!-- Starting with .NET 8, the default behavior of the .NET SDK and runtime is to only consider non-version-specific and non-distro-specific RIDs. -->
	<!-- https://learn.microsoft.com/en-us/dotnet/core/rid-catalog#using-rids -->
	<PropertyGroup>
<!--		<GenerateAssemblyInfo>False</GenerateAssemblyInfo>-->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<TargetPlatformVersion>10.0.19041.0</TargetPlatformVersion>
		<LangVersion>12.0</LangVersion>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<NoWarn>
			CA1416; <!-- This call site is reachable on all platforms. -->
		</NoWarn>
	</PropertyGroup>

</Project>
